{
  "name": "agentic-code-plugin",
  "displayName": "Agentic Code",
  "description": "Coordinates a main agent and parallel sub-agents, tuned for small local models.",
  "version": "0.0.1",
  "publisher": "oslind",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oslind/agentic_code_plugin.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Agents read and write project files and run checks, so the workspace must be trusted."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Agents need a real folder on disk to sandbox."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "agentic.plan",
        "title": "Agentic: Plan a task",
        "icon": "$(add)"
      },
      {
        "command": "agentic.refreshTasks",
        "title": "Agentic: Refresh tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "agentic.testModelConnection",
        "title": "Agentic: Test model connection"
      },
      {
        "command": "agentic.showLog",
        "title": "Agentic: Show log"
      },
      {
        "command": "agentic.runPlan",
        "title": "Agentic: Run plan",
        "icon": "$(play)"
      },
      {
        "command": "agentic.cancelRun",
        "title": "Agentic: Cancel run",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentic.applyRun",
        "title": "Agentic: Apply run to my branch",
        "icon": "$(git-merge)"
      },
      {
        "command": "agentic.retryTask",
        "title": "Agentic: Retry task",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentic.retryFailed",
        "title": "Agentic: Retry failed tasks",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentic.cancelTask",
        "title": "Agentic: Cancel task",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentic.showTaskLog",
        "title": "Agentic: Show log",
        "icon": "$(output)"
      },
      {
        "command": "agentic.cleanupRun",
        "title": "Agentic: Clean up run",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "Agentic Code",
      "properties": {
        "agentic.model.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Base URL of an OpenAI-compatible server (Ollama, LM Studio, vLLM, llama.cpp)."
        },
        "agentic.model.name": {
          "type": "string",
          "default": "qwen3.8:27b",
          "description": "Model name as the server knows it."
        },
        "agentic.model.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API key. Local servers usually need none."
        },
        "agentic.model.contextWindow": {
          "type": "number",
          "default": 32768,
          "description": "Context window in tokens. Prompts are budgeted to fit inside it."
        },
        "agentic.model.temperature": {
          "type": "number",
          "default": 0.2,
          "description": "Sampling temperature. Low values make small models follow formats more reliably."
        },
        "agentic.model.requestTimeoutMs": {
          "type": "number",
          "default": 300000,
          "description": "Timeout for one model request. Local models can be slow."
        },
        "agentic.model.structuredOutput": {
          "type": "string",
          "enum": [
            "json_schema",
            "json_object",
            "none"
          ],
          "default": "json_schema",
          "description": "How to ask the server for JSON. Use json_object or none if the server rejects json_schema."
        },
        "agentic.checks": {
          "type": "array",
          "default": [],
          "markdownDescription": "Checks that decide whether a task is done, run in each worker's worktree and again after each merge. Example: `[{\"name\": \"test\", \"command\": \"npm test\"}, {\"name\": \"lint\", \"command\": \"npm run lint\"}]`. Workers can run these by name but cannot run any other command.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "timeoutMs": {
                "type": "number"
              }
            }
          }
        },
        "agentic.maxParallelWorkers": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "How many workers run at once. A single local GPU usually serves one request at a time, so higher values mostly help with remote or batched servers."
        },
        "agentic.worker.maxTurns": {
          "type": "number",
          "default": 40,
          "description": "Tool calls a worker may make on one task before it is stopped."
        },
        "agentic.worker.maxFixRounds": {
          "type": "number",
          "default": 2,
          "description": "How many times a worker is sent failing check output to fix before the task fails."
        },
        "agentic.worktree.linkDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules"
          ],
          "description": "Folders linked from the project into each worktree so checks can run without reinstalling dependencies."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentic",
          "title": "Agentic",
          "icon": "media/agentic.svg"
        }
      ]
    },
    "views": {
      "agentic": [
        {
          "id": "agentic.tasks",
          "name": "Tasks"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentic.plan",
          "when": "view == agentic.tasks",
          "group": "navigation"
        },
        {
          "command": "agentic.refreshTasks",
          "when": "view == agentic.tasks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentic.runPlan",
          "when": "view == agentic.tasks && viewItem == run",
          "group": "inline"
        },
        {
          "command": "agentic.cancelRun",
          "when": "view == agentic.tasks && viewItem == run",
          "group": "inline"
        },
        {
          "command": "agentic.applyRun",
          "when": "view == agentic.tasks && viewItem == run"
        },
        {
          "command": "agentic.retryTask",
          "when": "view == agentic.tasks && viewItem =~ /^task-(failed|cancelled)$/",
          "group": "inline"
        },
        {
          "command": "agentic.cancelTask",
          "when": "view == agentic.tasks && viewItem =~ /^task-(running|verifying)$/",
          "group": "inline"
        },
        {
          "command": "agentic.showTaskLog",
          "when": "view == agentic.tasks && viewItem =~ /^(run|task-.*)$/"
        },
        {
          "command": "agentic.retryFailed",
          "when": "view == agentic.tasks && viewItem == run"
        },
        {
          "command": "agentic.cleanupRun",
          "when": "view == agentic.tasks && viewItem == run"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "vsce package --out agentic-code-plugin.vsix"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
